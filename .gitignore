node_modules/
dist/
*.log
.DS_Store

# Local-only DSH homes used by acceptance/probe runs: they contain a copied
# .credentials.yaml (API keys, OAuth tokens) and must never be committed.
.accept/
scripts/probe/tmp/
.credentials.yaml
.pnpm-store/

# Probe run artifacts: local evidence, never committed (see scripts/probe/README.md).
scripts/probe/out/

# Review artifacts produced by interactive agent workflows (Theseus
# `user-readiness-review` and its relatives): <phase>.review.md. They record the
# operator's own answers, verdicts and assessed understanding, so they stay
# local-only. Keep them on disk next to the change they belong to; use
# `git add -f` if one is ever meant to be published deliberately.
*.review.md
