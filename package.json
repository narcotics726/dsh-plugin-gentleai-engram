{
  "name": "dsh-plugin-gentleai-engram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial dsh (Cordis) plugin bridging the engram persistent-memory MCP backend: per-workspace connection pool, session binding, project injection, passive capture, and compaction recovery.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
