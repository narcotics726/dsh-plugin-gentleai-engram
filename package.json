{
  "name": "dsh-plugin-gentleai-engram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial dsh (Cordis) plugin bridging the engram persistent-memory MCP backend: per-session project/session binding, passive capture, and (P1) compaction recovery + context injection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  }
}
