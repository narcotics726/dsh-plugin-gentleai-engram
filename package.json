{
  "name": "dsh-plugin-gentleai-engram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial dsh (Cordis) plugin bridging the engram persistent-memory MCP backend: per-workspace connection pool, session binding, project injection, passive capture, and compaction recovery.",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.ts",
    "check:boundary": "node scripts/check-recall-boundary.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs --history",
    "check:hygiene:staged": "node scripts/check-hygiene.mjs --staged",
    "prepare": "test -d .githooks && git config core.hooksPath .githooks || true"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^24.0.0",
    "secretlint": "^13.0.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "onnxruntime-web": "1.29.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
